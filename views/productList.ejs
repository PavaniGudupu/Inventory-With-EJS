<%- include('partials/header') %>



 <div class="container mt-4">
    <h2 class="text-center mb-4">Product List</h2>
  <a href="/products/add" class="btn btn-success mb-2">➕ Add Product</a>
  <a href="/" class="btn btn-secondary mb-3">CLOSE</a>


  <div class="d-flex justify-content-end mb-3">
<form id="searchForm" class="d-flex" action="/products" method="post" style="gap: 8px;">

  <select name="filterCategory" class="form-select" style="width: 150px;">
      <!-- <option value="" disabled>Select the Categories</option> -->

      <!-- Product Table Columns -->
    <option value="p.product_name" <%= filterCategory === "p.product_name" ? "selected" : "" %>>Product Name</option>
    <option value="c.category" <%= filterCategory === "c.category" ? "selected" : "" %>>Category</option>
    <option value="p.mrp" <%= filterCategory === "p.mrp" ? "selected" : "" %>>MRP</option>
    <option value="p.sp" <%= filterCategory === "p.sp" ? "selected" : "" %>>SP</option>
    <option value="p.cp" <%= filterCategory === "p.cp" ? "selected" : "" %>>CP</option>
    <option value="p.classification" <%= filterCategory === "p.classification" ? "selected" : "" %>>Classification</option>
    <option value="p.size" <%= filterCategory === "p.size" ? "selected" : "" %>>Size</option>

</select>

<input 
  type="text" 
  name="searchValue" 
  id="searchInput"
  class="form-control"
  placeholder="Search..."
  value="<%= searchValue ? searchValue : '' %>"
  style="width: 200px;"
>

    <input type="hidden" name="limit" value="<%= pagination.current.limit %>">


  </form>
</div>




    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Category</th>      
                <th>MRP</th>
                <th>SP</th>
                <th>CP</th>
                <th>Classification</th>
                <th>Size</th>
                <th>Actions</th>
            </tr>
        </thead>
<tbody>
    <% products.forEach(product => { %>
        <tr>
            <td><%= product.id %></td>
            <td><%= product.product_name %></td>
            <td><%= product.category %></td>
            <td><%= product.mrp %></td>
            <td><%= product.sp %></td>
            <td><%= product.cp %></td>
            <td><%= product.classification %></td>
            <td><%= product.size %></td>

            <td>
<form action="/products/edit/<%= product.id %>" method="POST" style="display:inline;">
  <input type="hidden" name="page" value="<%= pagination.current.page %>">
  <input type="hidden" name="limit" value="<%= pagination.current.limit %>">
  <input type="hidden" name="searchValue" value="<%= searchValue %>">
  <input type="hidden" name="filterCategory" value="<%= filterCategory %>">
  <button type="submit" class="btn btn-primary btn-sm">Edit</button>
</form>



<form action="/products/delete/<%= product.id %>" method="POST" style="display:inline;">
    <input type="hidden" name="page" value="<%= pagination.current.page %>">
    <input type="hidden" name="limit" value="<%= pagination.current.limit %>">
    <input type="hidden" name="searchValue" value="<%= searchValue %>">
    <input type="hidden" name="filterCategory" value="<%= filterCategory %>">
    
    <button class="btn btn-danger btn-sm" onclick="return confirm('Delete this product?');">
        Delete
    </button>
</form>


            </td>
        </tr>
    <% }) %>
</tbody>

    </table>


    <nav aria-label="Page navigation example">
  <ul class="pagination justify-content-end">

    <% if (pagination) { %>

    <li class="page-item"></li>
    <form action="/products" method="POST" class="d-flex justify-content-end mb-3" style="gap: 8px;">
      <label for="limitInput" class="form-label mt-1">Limit</label>
      <input 
        type="number" 
        id="limitInput"
        name="limit" 
        value="<%= pagination.current.limit %>" 
        class="form-control" 
        style="width: 100px;"
      >
      <button type="submit" class="btn btn-outline-primary">Apply</button>
    </form>
  </li>
  <br>

    <!-- FIRST PAGE BUTTON -->
    <% if (pagination.current.page > 1) { %>
      <li class="page-item">
        <form action="/products" method="POST">
          <input type="hidden" name="page" value="1">
          <input type="hidden" name="limit" value="<%= pagination.current.limit %>">
          <input type="hidden" name="searchValue" value="<%= searchValue %>">
          <input type="hidden" name="filterCategory" value="<%= filterCategory %>">
          <button class="page-link" type="submit">First</button>
        </form>
      </li>
    <% } else { %>
      <li class="page-item disabled"><a class="page-link">First</a></li>
    <% } %>

    <!-- PREVIOUS BUTTON -->
    <% if (pagination.previous) { %>
      <li class="page-item">
        <form action="/products" method="POST">
          <input type="hidden" name="page" value="<%= pagination.previous.page %>">
          <input type="hidden" name="limit" value="<%= pagination.previous.limit %>">
          <input type="hidden" name="searchValue" value="<%= searchValue %>">
          <input type="hidden" name="filterCategory" value="<%= filterCategory %>">
          <button class="page-link" type="submit">Previous</button>
        </form>
      </li>
    <% } else { %>
      <li class="page-item disabled"><a class="page-link">Previous</a></li>
    <% } %>

    <!-- PAGE NUMBER BUTTONS -->
    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
      <li class="page-item <%= i === pagination.current.page ? 'active' : '' %>">
        <form action="/products" method="POST">
          <input type="hidden" name="page" value="<%= i %>">
          <input type="hidden" name="limit" value="<%= pagination.current.limit %>">
          <input type="hidden" name="searchValue" value="<%= searchValue %>">
          <input type="hidden" name="filterCategory" value="<%= filterCategory %>">
          <button class="page-link" type="submit"><%= i %></button>
        </form>
      </li>
    <% } %>

    <!-- NEXT BUTTON -->
    <% if (pagination.next) { %>
      <li class="page-item">
        <form action="/products" method="POST">
          <input type="hidden" name="page" value="<%= pagination.next.page %>">
          <input type="hidden" name="limit" value="<%= pagination.next.limit %>">
          <input type="hidden" name="searchValue" value="<%= searchValue %>">
          <input type="hidden" name="filterCategory" value="<%= filterCategory %>">
          <button class="page-link" type="submit">Next</button>
        </form>
      </li>
    <% } else { %>
      <li class="page-item disabled"><a class="page-link">Next</a></li>
    <% } %>

    <!-- LAST PAGE BUTTON -->
    <% if (pagination.current.page < pagination.totalPages) { %>
      <li class="page-item">
        <form action="/products" method="POST">
          <input type="hidden" name="page" value="<%= pagination.totalPages %>">
          <input type="hidden" name="limit" value="<%= pagination.current.limit %>">
          <input type="hidden" name="searchValue" value="<%= searchValue %>">
          <input type="hidden" name="filterCategory" value="<%= filterCategory %>">
          <button class="page-link" type="submit">Last</button>
        </form>
      </li>
    <% } else { %>
      <li class="page-item disabled"><a class="page-link">Last</a></li>
    <% } %>

    <% } %>
  </ul>
</nav>




<script>

let timer; //variable, cancel prev timer when user keeps typings

//id that has "searchInput" => addEventListener will attach an event.
// input => event type
// callback function -> automatically runs when event happens.

// if type, function will run on every keystroke.
document.getElementById("searchInput").addEventListener("input", function () {
    clearTimeout(timer); //ancels the previous scheduled search.

    const value = this.value.trim(); //Gets what the user typed.and trim() remove extra spaces.

    timer = setTimeout(() => { //If the user types during this time → timer is cancelled → new timer starts
        //if (value === "") {
            //window.location.href = "/products";  // show full list
       // } else {
            document.getElementById("searchForm").submit(); // auto search
       // }
    }, 600); //Search runs only after 400 milliseconds of no typing.
});
</script>

<script>
  window.onload = function () {
    const input = document.getElementById("searchInput");

    // Do NOT focus if search box is empty
    if (input && input.value.trim() !== "") {

      // Focus only when user has typed something earlier
      input.focus();

      // Keep cursor at end
      const val = input.value;
      input.value = "";
      input.value = val;
    }
  };
</script>




<%- include('partials/footer') %>
