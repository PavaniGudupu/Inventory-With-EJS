<%- include('partials/header') %>



 <div class="container mt-4">
    <h2 class="text-center mb-4">Inventory List</h2>
  <a href="/products/add" class="btn btn-success mb-3">➕ Add Product</a>
  <a href="/" class="btn btn-secondary mb-3">CLOSE</a>


  <div class="d-flex justify-content-end mb-3">
  <form class="d-flex" style="gap: 8px;">

    <select class="form-select" style="width: 150px;">
      <option value="">All Categories</option>
    <% categories.forEach(cat => { %>
     <option value="<%= cat.category %>">
            <%= cat.category %>
     </option>
    <% }) %>

    </select>

    <input 
      type="text" 
      class="form-control" 
      placeholder="Search..."
      style="width: 200px;"
    >

    <button class="btn btn-primary" type="submit">Search</button>

  </form>
</div>



    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Category</th>      
                <th>MRP</th>
                <th>SP</th>
                <th>CP</th>
                <th>Classification</th>
                <th>Size</th>
                <th>Actions</th>
            </tr>
        </thead>
<tbody>
    <% products.forEach(product => { %>
        <tr>
            <td><%= product.id %></td>
            <td><%= product.product_name %></td>
            <td><%= product.category %></td>
            <td><%= product.mrp %></td>
            <td><%= product.sp %></td>
            <td><%= product.cp %></td>
            <td><%= product.classification %></td>
            <td><%= product.size %></td>

            <td>
                <a href="/products/edit/<%= product.id %>" class="btn btn-primary btn-sm">Edit</a>

                <form action="/products/delete/<%= product.id %>" method="POST" style="display:inline;">
                <button class="btn btn-danger btn-sm" onclick="return confirm('Delete this product?');">
                    Delete
                </button>
                </form>

            </td>
        </tr>
    <% }) %>
</tbody>

    </table>




    
<nav aria-label="Page navigation example">
  <ul class="pagination justify-content-end">
    <% if (pagination.previous) { %>
      <li class="page-item">
        <a class="page-link" href="/products?page=<%= pagination.previous.page %>&limit=<%= pagination.previous.limit %>">Previous</a>
      </li>
    <% } else { %>
      <li class="page-item disabled"><a class="page-link">Previous</a></li>
    <% } %>

    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
      <li class="page-item <%= i === pagination.current.page ? 'active' : '' %>">
        <a class="page-link" href="/products?page=<%= i %>&limit=<%= pagination.current.limit %>"><%= i %></a>
      </li>
    <% } %>

    <% if (pagination.next) { %>
      <li class="page-item">
        <a class="page-link" href="/products?page=<%= pagination.next.page %>&limit=<%= pagination.next.limit %>">Next</a>
      </li>
    <% } else { %>
      <li class="page-item disabled"><a class="page-link">Next</a></li>
    <% } %>
  </ul>
</nav>



<%- include('partials/footer') %>


