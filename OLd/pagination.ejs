
<%- include('partials/header') %>

 <!-- ZingGrid-style pagination with page-number input -->
<div class="d-flex justify-content-end align-items-center mb-4" style="gap: 10px;">

  <!-- FIRST PAGE -->
  <a href="/products?page=1&limit=<%= pagination.current.limit %>" 
     class="btn btn-outline-primary <%= pagination.current.page === 1 ? 'disabled' : '' %>">
     First
  </a>

  <!-- PREV PAGE -->
  <% if (pagination.previous) { %>
    <a href="/products?page=<%= pagination.previous.page %>&limit=<%= pagination.current.limit %>" 
       class="btn btn-outline-primary">
       Prev
    </a>
  <% } else { %>
    <button class="btn btn-outline-primary disabled">Prev</button>
  <% } %>

  <!-- PAGE NUMBER INPUT -->
  <form method="GET" action="/products" class="d-flex" style="gap: 5px;">
    <input 
      type="number" 
      name="page" 
      min="1" 
      max="<%= pagination.totalPages %>" 
      value="<%= pagination.current.page %>" 
      class="form-control"
      style="width: 70px;"
    >

    <input type="hidden" name="limit" value="<%= pagination.current.limit %>">

    <button class="btn btn-primary">Go</button>
  </form>

  <span class="ms-2">of <strong><%= pagination.totalPages %></strong></span>

  <!-- NEXT PAGE -->
  <% if (pagination.next) { %>
    <a href="/products?page=<%= pagination.next.page %>&limit=<%= pagination.current.limit %>" 
       class="btn btn-outline-primary">
       Next
    </a>
  <% } else { %>
    <button class="btn btn-outline-primary disabled">Next</button>
  <% } %>

  <!-- LAST PAGE -->
  <a href="/products?page=<%= pagination.totalPages %>&limit=<%= pagination.current.limit %>" 
     class="btn btn-outline-primary <%= pagination.current.page === pagination.totalPages ? 'disabled' : '' %>">
     Last
  </a>

</div>


</div>

<%- include('partials/footer') %> -->


